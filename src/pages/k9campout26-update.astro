---
// Instant redirect to the 2026 details-update form (was a layout:null Jekyll page).
const url = "https://forms.microsoft.com/r/7E4AKCQa7V";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0; url=${url}`} />
		<link rel="canonical" href={url} />
		<title>Redirecting…</title>
		<meta name="robots" content="noindex" />
		<script is:inline define:vars={{ url }}>
			window.location.replace(url);
		</script>
	</head>
	<body>
		<p>
			Redirecting to the K9 Campout 2026 update form… If you are not redirected automatically,
			<a href={url}>click here</a>.
		</p>
	</body>
</html>
