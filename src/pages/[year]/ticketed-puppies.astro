---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import SiteLayout from "../../layouts/SiteLayout.astro";
import PT from "../../components/PT.astro";
import { longDate } from "../../utils/posts";

const { year } = Astro.params;
if (!year || !/^20\d{2}$/.test(year)) return Astro.rewrite("/404");

const { entry: page, cacheHint } = await getEmDashEntry("pages", `${year}-ticketed-puppies`);
if (!page) return Astro.rewrite("/404");
Astro.cache.set(cacheHint);

// The attendee table is generated from the `attendees` collection so rows can
// be added/edited individually (admin UI, MCP, CLI) instead of editing one
// giant embedded table. Years without collection entries (2025 archive) fall
// back to whatever table lives in the page content itself.
const { entries: attendees, cacheHint: attendeesHint } = await getEmDashCollection("attendees", {
	where: { year },
	orderBy: { sort: "asc" },
	limit: 1000,
});
Astro.cache.set(attendeesHint);

// Insert the generated table right under the "Complete Attendee List" heading
// (falling back to the end of the content when no such heading exists).
type PTBlock = { _type: string; style?: string; children?: { text?: string }[] };
const content = (page.data.content ?? []) as PTBlock[];
const blockText = (b: PTBlock) => (b.children ?? []).map((c) => c.text ?? "").join("");
const headingIdx = content.findIndex(
	(b) => b._type === "block" && /^h[1-6]$/.test(b.style ?? "") && /attendee list/i.test(blockText(b)),
);
const splitAt = headingIdx === -1 ? content.length : headingIdx + 1;
const contentBefore = content.slice(0, splitAt);
const contentAfter = content.slice(splitAt);

// "Last updated" reflects the newest change to the page or any attendee row.
const timestamps = [
	page.data.updatedAt,
	...attendees.map((a) => a.data.updatedAt),
].filter(Boolean) as Date[];
const lastUpdated = timestamps.length
	? new Date(Math.max(...timestamps.map((t) => +new Date(t))))
	: null;

const canonicalPath = `/${year}/ticketed-puppies`;
---

<SiteLayout
	title={page.data.title}
	description={page.data.description ?? undefined}
	bodyClass="layout--single"
	canonical={`https://k9campout.com${canonicalPath}`}
	content={{ collection: "pages", id: page.data.id, slug: page.id }}
>
	<div id="main" role="main">
		<article class="page h-entry" itemscope itemtype="https://schema.org/CreativeWork">
			<meta itemprop="headline" content={page.data.title} />

			<div class="page__inner-wrap">
				<header>
					<h1 id="page-title" class="page__title p-name" itemprop="headline">
						<a href={`https://k9campout.com${canonicalPath}`} itemprop="url">{page.data.title}</a>
					</h1>
				</header>

				<section class="page__content e-content" itemprop="text">
					<div {...page.edit.content}>
						<PT value={contentBefore} />
					</div>

					{attendees.length > 0 && (
						<div class="emdash-table-wrapper">
							<table class="emdash-table">
								<thead>
									<tr>
										<th>Ticket Type</th>
										<th>Ticket Code</th>
										<th>Order ID</th>
										<th>Site Assignment</th>
										<th>Tag Name</th>
										<th>Bus</th>
									</tr>
								</thead>
								<tbody>
									{attendees.map((a) => (
										<tr>
											<td>{a.data.ticket_type}</td>
											<td>{a.data.ticket_code}</td>
											<td>{a.data.order_id}</td>
											<td>{a.data.site}</td>
											<td>{a.data.tag_name}</td>
											<td>{a.data.bus}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					)}

					{contentAfter.length > 0 && <PT value={contentAfter} />}

					{attendees.length > 0 && lastUpdated && (
						<p class="page__meta">
							<em>Last updated: {longDate(lastUpdated)}</em>
						</p>
					)}
				</section>
			</div>
		</article>
	</div>
</SiteLayout>
