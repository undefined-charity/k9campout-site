---
// Minimal Mistakes {% include gallery %} equivalent.
interface GalleryImage {
	url?: string;
	image_path: string;
	alt?: string;
	title?: string;
}

interface Props {
	images: GalleryImage[];
	caption?: string | null;
	layout?: string | null;
}

const { images, caption, layout } = Astro.props;
const figureClass = `${layout ?? "half"} `;
---

<figure class={figureClass}>
	{images.map((img) =>
		img.url ? (
			<a href={img.url} title={img.title}>
				<img src={img.image_path} alt={img.alt ?? ""} />
			</a>
		) : (
			<img src={img.image_path} alt={img.alt ?? ""} title={img.title} />
		),
	)}
	{caption && <figcaption>{caption}</figcaption>}
</figure>
