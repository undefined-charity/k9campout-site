{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "k9campout",
	"account_id": "6d736965c0493a8136b5c31ac7be7d69", // Undefined Charity
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Custom domain cutover: uncomment once k9campout.com's DNS is on this
	// Cloudflare account (zone added + nameservers moved). Until then the site
	// is reachable at k9campout.<account>.workers.dev for testing.
	// "routes": [
	// 	{ "pattern": "k9campout.com", "custom_domain": true },
	// 	{ "pattern": "www.k9campout.com", "custom_domain": true },
	// ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "k9campout-emdash-db",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "k9campout-media",
		},
	],
	// Worker Loader for plugin sandboxing — requires the Workers Paid plan.
	// Comment this block out to run on the free plan without plugins.
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
	"observability": {
		"enabled": true,
	},
}
