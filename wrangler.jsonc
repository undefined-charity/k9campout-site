{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "k9campout",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "k9campout-emdash-db",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "k9campout-media",
		},
	],
	// Worker Loader for plugin sandboxing — requires the Workers Paid plan.
	// Comment this block out to run on the free plan without plugins.
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
	"observability": {
		"enabled": true,
	},
}
