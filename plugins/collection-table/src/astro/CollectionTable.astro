---
// Site-side renderer for the `collection_table` Portable Text block.
// Queries the configured collection at request time and renders a table.
import { getEmDashCollection } from "emdash";

interface Props {
	node: {
		_type: "collection_table";
		collection?: string;
		filter_field?: string;
		filter_value?: string;
		order_by?: string;
		columns?: string;
		show_last_updated?: boolean;
	};
}

const { node } = Astro.props;
const collection = node?.collection?.trim();

// "field:Label, field2:Label2:last3" → [{field, label, transform}].
// Bare "field" uses the field name as its label. The third segment is an
// optional display transform — fields NOT listed here are never rendered,
// so sensitive columns (emails, handles, full codes) stay private simply
// by omission or masking:
//   last3 / last4 — mask all but the trailing N characters (****abc)
const columns = (node?.columns ?? "")
	.split(",")
	.map((c) => c.trim())
	.filter(Boolean)
	.map((c) => {
		const [field, label, transform] = c.split(":").map((p) => p.trim());
		return { field, label: label || field, transform: transform || null };
	});

function display(value: unknown, transform: string | null): string {
	const text = String(value ?? "");
	const lastN = transform?.match(/^last(\d)$/);
	if (lastN) {
		const n = Number(lastN[1]);
		return text.length > n ? "****" + text.slice(-n) : text;
	}
	return text;
}

let entries: Array<{ data: Record<string, unknown> }> = [];
let error: string | null = null;

if (!collection) {
	error = "collection_table block: no collection configured";
} else if (columns.length === 0) {
	error = "collection_table block: no columns configured";
} else {
	try {
		const query: Record<string, unknown> = { limit: 1000 };
		if (node.filter_field && node.filter_value) {
			query.where = { [node.filter_field]: node.filter_value };
		}
		if (node.order_by) {
			query.orderBy = { [node.order_by]: "asc" };
		}
		const result = await getEmDashCollection(collection, query);
		entries = result.entries ?? [];
		if (result.cacheHint) Astro.cache.set(result.cacheHint);
	} catch (e) {
		error = `collection_table block: query failed (${e instanceof Error ? e.message : e})`;
	}
}

const lastUpdated = node?.show_last_updated
	? entries
			.flatMap((e) => [e.data.updatedAt, e.data.publishedAt, e.data.createdAt])
			.filter(Boolean)
			.map((t) => +new Date(t as string | Date))
			.filter((n) => Number.isFinite(n))
			.reduce((a, b) => Math.max(a, b), 0)
	: 0;

const lastUpdatedLabel = lastUpdated
	? new Date(lastUpdated).toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
			timeZone: "America/Los_Angeles",
		})
	: null;
---

{error ? (
	<p class="collection-table-error"><em>{error}</em></p>
) : (
	<>
		<div class="emdash-table-wrapper">
			<table class="emdash-table">
				<thead>
					<tr>
						{columns.map((col) => (
							<th>{col.label}</th>
						))}
					</tr>
				</thead>
				<tbody>
					{entries.map((entry) => (
						<tr>
							{columns.map((col) => (
								<td>{display(entry.data[col.field], col.transform)}</td>
							))}
						</tr>
					))}
				</tbody>
			</table>
		</div>
		{lastUpdatedLabel && (
			<p class="page__meta">
				<em>Last updated: {lastUpdatedLabel}</em>
			</p>
		)}
	</>
)}

<style>
	.collection-table-error {
		color: #a33;
	}
</style>
